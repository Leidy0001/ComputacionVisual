		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="insnot1" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="insnot2" class="java.math.BigDecimal">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<field name="suma" class="java.math.BigDecimal"/>
	<field name="promedio" class="java.math.BigDecimal"/>
	<field name="estado" class="java.lang.String"/>
	<field name="curnom" class="java.lang.String">
		<fieldDescription><![CDATA[]]></fieldDescription>
	</field>
	<variable name="varHombres" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{estgen}.equals("M") ? 1 : 0]]></variableExpression>
	</variable>
	<variable name="varMujeres" class="java.lang.Integer" calculation="Sum">
		<variableExpression><![CDATA[$F{estgen}.equals("F") ? 1 : 0]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
